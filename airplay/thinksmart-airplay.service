[Unit]
Description=ThinkSmart Unified AirPlay (Audio + Screen Mirroring + Auto-Rotate)
After=network-online.target pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=simple
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u /usr/local/bin/thinksmart-airplay.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
