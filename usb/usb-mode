#!/bin/bash
MODE="${1:-status}"
ROLE_PATH="/sys/class/usb_role/7000000.usb-role-switch/role"
need_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "usb-mode: root privileges required (run with sudo)" >&2
        exit 1
    fi
}
wait_role() {
    local target="$1" i=0 cur=""
    while [ $i -lt 20 ]; do
        cur="$(cat "$ROLE_PATH" 2>/dev/null || true)"
        [ "$cur" = "$target" ] && break
        sleep 0.05
        i=$((i + 1))
    done
    echo "USB role set to: $cur"
    [ "$cur" = "$target" ]
}
if [ "$MODE" = "host" ]; then
    need_root
    modprobe -a usb-storage uas 2>/dev/null || true
    echo host > "$ROLE_PATH" 2>/dev/null || true
    wait_role host
elif [ "$MODE" = "device" ]; then
    need_root
    echo device > "$ROLE_PATH" 2>/dev/null || true
    wait_role device
elif [ "$MODE" = "status" ] && [ "$#" -le 1 ]; then
    echo "Current USB role: $(cat "$ROLE_PATH" 2>/dev/null)"
    ls -la /sys/bus/usb/devices/ 2>/dev/null || true
else
    echo "Usage: usb-mode [host|device|status]" >&2
    exit 2
fi
