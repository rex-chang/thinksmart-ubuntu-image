[Unit]
Description=ThinkSmart NetEase music app (touch UI on loopback :8091)
After=network.target

[Service]
ExecStart=/opt/thinksmart-addons/venv/bin/python /usr/local/bin/thinksmart-music.py
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 XDG_RUNTIME_DIR=/run/user/1000
Restart=always
RestartSec=5
MemoryMax=64M

[Install]
WantedBy=default.target
