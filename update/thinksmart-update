#!/usr/bin/python3
"""thinksmart-update: checks for and installs releases of the voice client and of the system layer
(runs as root).

  thinksmart-update check            fetch the release manifest, note a newer version
  thinksmart-update run              handle the requests the page dropped in requests/ (check, install)
  thinksmart-update install VERSION  install the checked version (what a page request ends in)
  thinksmart-update boot             finish or undo an install a power cut interrupted (check, run
                                     and install do this first too: an install killed mid-way)
  thinksmart-update adopt DIR [VER]  take an existing client checkout as the installed version
  thinksmart-update system-apply DIR install the system layer from a checkout of thinksmart-ubuntu-image
                                     (image/device-setup.sh files): no backup, no restarts
  thinksmart-update system-verify    print the system layer version and its file-set id; exit 1 if
                                     an installed file differs from what was installed (build-image.sh)
  thinksmart-update selftest         exit 0 if this script loads and reads its configuration

Nothing is installed without a user's tap: the timer only checks. The page (client, user ubuntu)
and the welcome page (kiosk, ubuntu) only read status.json and drop a request file; this script
installs only the version it fetched itself, whatever the request says.

No signatures (decided 2026-11-01, no key to keep): releases come only over HTTPS (plain http only
from this machine, for a test server), and every file must match the size and sha256 the manifest
names, so a broken or truncated download is never installed.

Layout: /opt/thinksmart/client/<version>/ (root-owned, .venv -> ../../envs/<id>), current and
previous symlinks; /opt/thinksmart/envs/<id>/ Python environments named by the hash of the
release's requirements.lock. User data (~/.config/thinksmart-client, the hub's data/, the kiosk
conf, Wi-Fi) lives elsewhere and is never touched.

Release layout under each source URL (GitHub Releases or a test server, same paths):
  latest/download/latest.json                                    manifest
  download/client-v1.2.3/thinksmart-client-1.2.3.tar.gz          paths named in the manifest

System layer (2026-11-07): the same release may carry a "system" entry, a package of this
repository's own files (shell, welcome page, keyboard, screen and mic services, audio and Bluetooth
configuration, this updater). image/system-files.txt in the package says where each file goes and
what to restart when it changed; files not in that table (kernel, boot partition, apt packages, the
user's configuration) are never touched. Before installing, every file the table names is copied to
/opt/thinksmart/system/backup/; if the restarted services don't come back, or power is cut on the
way, the backup is put back. Versions: /opt/thinksmart/system/installed.json, none = 0.1.0 (the
20261101 image). The client fields of status.json stay at the top level, the system ones are under
"system"; the page asks for both with one request and the system layer goes first.
"""
import datetime
import fcntl
import grp
import hashlib
import http.client
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import tarfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

CONF = Path('/etc/thinksmart-update.conf')
STATE = Path('/var/lib/thinksmart-update')
STATUS = STATE / 'status.json'
REQUESTS = STATE / 'requests'
DOWNLOAD = STATE / 'download'
PENDING = STATE / 'pending.json'       # a switch that hasn't passed its self-test yet
LOCK = Path('/run/thinksmart-update.lock')
OPT = Path('/opt/thinksmart')
CLIENT = OPT / 'client'
ENVS = OPT / 'envs'
UNIT = 'thinksmart-client.service'
UNIT_FILE = Path('/etc/systemd/system') / UNIT
HEALTH = 'http://127.0.0.1:8090/api/health'
TEST_SECONDS = 90          # a new version must answer the health check within this
BOOT_TEST_SECONDS = 240    # after a reboot the hub and audio take longer to come up
HUB_FRESH = 30             # the client asks the hub every 10 s; older than this = not reachable
SPARE = 50 << 20           # keep this much free on the root partition after an install

LOCAL_HOSTS = ('127.0.0.1', 'localhost', '::1')   # plain http allowed only for these (test sources)
VERSION_RE = re.compile(r'\d{1,4}\.\d{1,4}\.\d{1,4}')   # also a directory name under CLIENT
ENV_ID_RE = re.compile(r'[0-9a-f]{16}')                    # a directory name under ENVS

ACTIVE_JOBS = ('preparing', 'downloading', 'installing', 'testing', 'rolling_back')

UPDATER_VERSION = 2        # 1: client only (the 20261101 image); 2: also the system layer.
                           # The client's deploy/bootstrap-updater compares this.
ROOT = Path('/')           # where table destinations are (tests point it elsewhere)
SYSTEM = OPT / 'system'
SYS_RECORD = SYSTEM / 'installed.json'
SYS_BACKUP = SYSTEM / 'backup'
SYS_PENDING = STATE / 'system-pending.json'
SYS_BASELINE = '0.1.0'     # devices without a record: the 20261101 image
TABLE = 'image/system-files.txt'
POST = 'image/system-post.sh'
DEST_PREFIXES = ('/usr/local/', '/etc/', '/home/ubuntu/.config/')
OWNERS = ('root', 'ubuntu')
USER = 'ubuntu'
SIMPLE_ACTIONS = {'none', 'keep', 'reload', 'kiosk', 'mic', 'wireplumber', 'pipewire', 'bluetooth',
                  'boot', 'updater'}
UNIT_RE = re.compile(r'[A-Za-z0-9@_.-]+\.(service|timer|path|socket)')
PKG_RE = re.compile(r'[a-z0-9][a-z0-9.+-]*')


class Fail(Exception):
    """An error to show on the page as it is (Chinese, for the user)."""


def log(*args):
    print(*args, flush=True)


# ---- configuration and status ----

def read_conf():
    conf = {'SOURCES': '', 'PROXY': '', 'REQUEST_GROUP': 'ubuntu'}
    try:
        for line in CONF.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith('#') and '=' in line:
                k, v = line.split('=', 1)
                conf[k.strip()] = v.strip().strip('"\'')
    except OSError:
        pass
    return conf


def load_status():
    try:
        return json.loads(STATUS.read_text())
    except (OSError, ValueError):
        return {}


def write_durable(path, text):
    """Write a file that power-cut recovery reads, and have it (and everything written before it)
    on disk before going on. ext4 writes a new file's data up to ~30 s late but the rename of it
    much sooner: without this a power cut can leave a pending record or a backup that exists but
    is empty, and recovery would then skip the rollback or restore empty files."""
    tmp = path.with_name(f'.{path.name}.tmp')
    with open(tmp, 'w') as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)
    os.sync()


def save_status(st):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATUS.with_suffix('.tmp')
    tmp.write_text(json.dumps(st, ensure_ascii=False, indent=1))
    tmp.chmod(0o644)
    tmp.replace(STATUS)


def set_job(st, state, version, message='', progress=None, component='client'):
    st['job'] = {'state': state, 'version': version, 'message': message, 'progress': progress,
                 'time': int(time.time()), 'component': component}
    save_status(st)
    log(f'[{component} {state}] {version} {message}')


def version_key(v):
    try:
        return tuple(int(x) for x in v.split('.'))
    except (AttributeError, ValueError):
        return (-1,)


def current_version():
    try:
        return os.readlink(CLIENT / 'current')
    except OSError:
        return None


def previous_version():
    try:
        return os.readlink(CLIENT / 'previous')
    except OSError:
        return None


# ---- network ----

def allowed_url(url):
    u = urllib.parse.urlsplit(url)
    return u.scheme == 'https' or (u.scheme == 'http' and u.hostname in LOCAL_HOSTS)


class HttpsOnlyRedirects(urllib.request.HTTPRedirectHandler):
    """GitHub redirects release downloads to its file host; never follow one to plain http."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not allowed_url(newurl):
            raise urllib.error.URLError(f'refusing redirect to {newurl}')
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def opener(conf):
    handlers = [HttpsOnlyRedirects()]
    if conf['PROXY']:
        handlers.append(urllib.request.ProxyHandler({'http': conf['PROXY'], 'https': conf['PROXY']}))
    return urllib.request.build_opener(*handlers)


def fetch(conf, url, limit):
    req = urllib.request.Request(url, headers={'User-Agent': 'thinksmart-update'})
    with opener(conf).open(req, timeout=20) as r:
        data = r.read(limit + 1)
    if len(data) > limit:
        raise Fail('更新服务器返回的内容太大')
    return data


def fetch_manifest(conf, st):
    """The newest valid manifest from the first source that answers; Fail otherwise."""
    sources = conf['SOURCES'].split()
    if not sources:
        raise Fail('没有配置更新地址')
    errors = []
    for src in sources:
        if not allowed_url(src):
            errors.append(f'{src}: not https')
            continue
        try:
            m = json.loads(fetch(conf, src + 'latest/download/latest.json', 64 << 10))
        except (OSError, urllib.error.URLError, http.client.HTTPException, Fail, ValueError) as e:
            errors.append(f'{src}: {e}')
            continue
        if not valid_manifest(m):
            errors.append(f'{src}: not a client manifest')
            continue
        # a replayed old manifest (to keep the device on a vulnerable version) is refused
        seen = st.get('published')
        if seen and _when(m.get('published')) < _when(seen):
            errors.append(f'{src}: manifest older than one seen before')
            continue
        st['published'] = m.get('published')
        m['_source'] = src
        return m
    log('manifest:', '; '.join(errors))
    if all(e.endswith(': not https') for e in errors):
        raise Fail('更新地址必须是 https')
    if any(e.endswith(': not a client manifest') for e in errors):
        raise Fail('更新服务器上的版本信息不对，已忽略')
    raise Fail('连不上更新服务器')


def valid_manifest(m):
    """Shape check: the version and environment id become directory names, sizes and hashes are
    what each download is checked against."""
    try:
        files = m['files']
        ok = (m.get('component') == 'client' and VERSION_RE.fullmatch(m['version'])
              and ENV_ID_RE.fullmatch(files['env']['id'])
              and isinstance(m.get('notes', []), list))
        for item in (files['code'], files['env']):
            ok = ok and (isinstance(item['path'], str) and '..' not in item['path']
                         and not item['path'].startswith('/')
                         and isinstance(item['size'], int) and item['size'] > 0
                         and re.fullmatch(r'[0-9a-f]{64}', item['sha256']))
        return bool(ok)
    except (KeyError, TypeError):
        return False


def _when(s):
    try:
        return datetime.datetime.fromisoformat(s).timestamp()
    except (TypeError, ValueError):
        return 0


def env_present(env_id):
    return (ENVS / env_id / 'bin' / 'python').exists()


def download_size(m):
    f = m['files']
    return f['code']['size'] + (0 if env_present(f['env']['id']) else f['env']['size'])


def download(conf, m, item, st, version, done_before, total):
    """Download one file of the release into DOWNLOAD, checking size and sha256 as it streams."""
    DOWNLOAD.mkdir(parents=True, exist_ok=True)
    dest = DOWNLOAD / Path(item['path']).name
    sources = [m['_source']] + [s for s in conf['SOURCES'].split() if s != m['_source'] and allowed_url(s)]
    last_error = None
    for src in sources:
        h, got, shown = hashlib.sha256(), 0, 0
        try:
            req = urllib.request.Request(src + 'download/' + item['path'],
                                         headers={'User-Agent': 'thinksmart-update'})
            with opener(conf).open(req, timeout=30) as r, open(dest, 'wb') as f:
                while True:
                    chunk = r.read(64 << 10)
                    if not chunk:
                        break
                    got += len(chunk)
                    if got > item['size']:
                        raise Fail('下载的文件比清单里写的大')
                    h.update(chunk)
                    f.write(chunk)
                    if time.monotonic() - shown > 1:
                        shown = time.monotonic()
                        set_job(st, 'downloading', version, '正在下载', (done_before + got) / total,
                                (st.get('job') or {}).get('component', 'client'))
        # a connection cut half way raises http.client.IncompleteRead, not an OSError
        except (OSError, urllib.error.URLError, http.client.HTTPException) as e:
            last_error = e
            log(f'download {src}: {e}')
            continue
        except Fail:
            dest.unlink(missing_ok=True)
            raise
        if got != item['size'] or h.hexdigest() != item['sha256']:
            dest.unlink(missing_ok=True)
            raise Fail('下载的文件校验不对（可能被改过或没下完整），没有安装')
        return dest
    log('download failed everywhere:', repr(last_error))
    raise Fail('下载失败：网络断了或者更新服务器没有响应，请稍后再试')


# ---- install ----

def extract(tgz, dest, data_filter):
    """Unpack into dest (created fresh). 'data' refuses absolute paths, '..', links out of dest and
    device files; environments use 'tar' because their bin/python links to /usr/bin/python3."""
    if dest.exists():
        shutil.rmtree(dest)
    dest.mkdir(parents=True)
    with tarfile.open(tgz) as t:
        t.extractall(dest, filter='data' if data_filter else 'tar')


def link_env(release_dir, env_id):
    venv = release_dir / '.venv'
    if venv.is_symlink() or venv.exists():
        venv.unlink() if venv.is_symlink() else shutil.rmtree(venv)
    venv.symlink_to(Path('..') / '..' / 'envs' / env_id)
    # the client can't write .pyc next to root-owned code: compile now so it doesn't on every start
    subprocess.run([str(release_dir / '.venv' / 'bin' / 'python'), '-m', 'compileall', '-q',
                    str(release_dir / 'thinksmart_client')], check=False)


def set_link(name, version):
    tmp = CLIENT / f'.{name}.tmp'
    tmp.unlink(missing_ok=True)
    if version is None:
        (CLIENT / name).unlink(missing_ok=True)
        return
    tmp.symlink_to(version)
    os.replace(tmp, CLIENT / name)    # atomic: a power cut leaves the old or the new link


def sync_unit(version):
    """A release may change its service file (deploy/thinksmart-client.service): use the one of the
    version that is about to run."""
    src = CLIENT / version / 'deploy' / UNIT
    if src.exists() and (not UNIT_FILE.exists() or src.read_bytes() != UNIT_FILE.read_bytes()):
        shutil.copyfile(src, UNIT_FILE)
        subprocess.run(['systemctl', 'daemon-reload'], check=False)


def restart_client(version):
    sync_unit(version)
    subprocess.run(['systemctl', 'restart', UNIT], check=False)


def health():
    try:
        with urllib.request.urlopen(HEALTH, timeout=3) as r:
            return json.loads(r.read())
    except (OSError, ValueError):
        return None


def self_test(version, need_hub, seconds):
    """(True, '') once the client reports this version with audio (and the hub, if it was reachable
    before the update); (False, why) after `seconds`."""
    end = time.monotonic() + seconds
    h = None
    while time.monotonic() < end:
        time.sleep(3)
        h = health()
        if not h or h.get('version') != version:
            continue
        if h.get('audio') and (h.get('hub') or not need_hub):
            # still up a few seconds later (not crashing right after the first answer)?
            time.sleep(5)
            h2 = health()
            if h2 and h2.get('version') == version:
                return True, ''
    if not h:
        return False, f'新版本 {seconds} 秒内没有启动起来'
    if h.get('version') != version:
        return False, '新版本没有启动起来'
    if not h.get('audio'):
        return False, '新版本打不开麦克风或扬声器'
    return False, '新版本连不上小智网关'


def cleanup():
    keep = {current_version(), previous_version()} - {None}
    envs = set()
    for d in CLIENT.iterdir():
        if d.is_symlink() or not d.is_dir():
            continue
        if d.name in keep:
            try:
                envs.add(os.readlink(d / '.venv').rsplit('/', 1)[-1])
            except OSError:
                pass
        else:
            shutil.rmtree(d, ignore_errors=True)
    for d in ENVS.iterdir():
        if d.name not in envs:
            shutil.rmtree(d, ignore_errors=True)
    shutil.rmtree(DOWNLOAD, ignore_errors=True)


def install(conf, version):
    st = load_status()
    cur = current_version()
    try:
        set_job(st, 'preparing', version, '正在准备')
        m = fetch_manifest(conf, st)       # again: something newer may have been published since
        if m['version'] != version:
            note_available(st, m, cur)
            raise Fail(f'更新服务器上的版本已经变成 {m["version"]}，请重新点更新')
        if cur and version_key(version) <= version_key(cur):
            raise Fail(f'{version} 不比现在的 {cur} 新')
        files = m['files']
        total = download_size(m)
        if shutil.disk_usage(OPT).free < total * 4 + SPARE:   # download + unpacked (~3x)
            raise Fail('存储空间不够，没有安装')
        before = health()
        need_hub = bool(before and before.get('hub'))

        set_job(st, 'downloading', version, '正在下载', 0)
        code = download(conf, m, files['code'], st, version, 0, total)
        env_id = files['env']['id']
        env_tgz = None
        if not env_present(env_id):
            env_tgz = download(conf, m, files['env'], st, version, files['code']['size'], total)

        set_job(st, 'installing', version, '正在安装')
        new_dir = CLIENT / f'{version}.new'
        extract(code, new_dir, True)
        if env_tgz:
            extract(env_tgz, ENVS / f'{env_id}.new', False)
            os.replace(ENVS / f'{env_id}.new', ENVS / env_id)
        link_env(new_dir, env_id)
        if (CLIENT / version).exists():           # left over from a failed try
            shutil.rmtree(CLIENT / version)
        os.replace(new_dir, CLIENT / version)
    except Fail as e:
        set_job(st, 'failed', version, str(e))
        return 1
    except Exception as e:  # noqa: BLE001 - anything else still has to reach the page
        log('install failed:', repr(e))
        set_job(st, 'failed', version, f'安装出错：{e}')
        return 1

    pending = {'from': cur, 'to': version, 'previous': previous_version(), 'need_hub': need_hub}
    # durable, and with it the unpacked version: else a power cut right after the switch can leave
    # current pointing at empty files and no record that it still needs its self-test
    write_durable(PENDING, json.dumps(pending))
    set_link('previous', cur)
    set_link('current', version)
    set_job(st, 'testing', version, '正在重启并自检')
    restart_client(version)
    return finish(conf, st, pending, TEST_SECONDS)


def finish(conf, st, pending, seconds):
    """Self-test the switched-to version; keep it or switch back."""
    version, old = pending['to'], pending['from']
    ok, why = self_test(version, pending['need_hub'], seconds)
    if ok:
        PENDING.unlink(missing_ok=True)
        st['current'] = version
        st['available'] = None
        st.pop('failed', None)
        set_job(st, 'done', version, f'已更新到 {version}')
        cleanup()
        return 0
    log('self-test failed:', why)
    if not old:
        set_job(st, 'failed', version, why + '，也没有可以退回的版本')
        return 1
    set_job(st, 'rolling_back', version, why + f'，正在退回 {old}')
    set_link('current', old)
    set_link('previous', pending.get('previous'))
    restart_client(old)
    PENDING.unlink(missing_ok=True)
    st['current'] = old
    st['failed'] = version
    ok_old, _ = self_test(old, False, seconds)
    shutil.rmtree(CLIENT / version, ignore_errors=True)
    cleanup()
    msg = f'{version} 自检没通过（{why}），已退回 {old}'
    if not ok_old:
        msg += '，但退回后客户端也没正常启动，请重启设备'
    set_job(st, 'rolled_back', version, msg)
    return 1


# ---- system layer ----

def target(dest):
    return ROOT / dest.lstrip('/')


def file_sha(path):
    try:
        h = hashlib.sha256()
        with open(path, 'rb') as f:
            for chunk in iter(lambda: f.read(1 << 20), b''):
                h.update(chunk)
        return h.hexdigest()
    except OSError:
        return None


def valid_action(a):
    if a in SIMPLE_ACTIONS:
        return True
    kind, _, unit = a.partition(':')
    return kind in ('system', 'user') and bool(UNIT_RE.fullmatch(unit))


def read_table(tree):
    """[(src, dest, mode, owner, actions)], [required packages] from image/system-files.txt.
    Lines: SRC DEST MODE OWNER ACTIONS (comma separated); SRC '-' = a file the post script edits
    (backed up, compared, never installed); 'require PACKAGE' = a package the layer needs."""
    entries, requires, seen = [], [], set()
    try:
        text = (tree / TABLE).read_text()
    except OSError:
        raise Fail('系统层更新包里没有文件表')
    for line in text.splitlines():
        line = line.split('#', 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if parts[0] == 'require' and len(parts) == 2 and PKG_RE.fullmatch(parts[1]):
            requires.append(parts[1])
            continue
        if len(parts) != 5:
            raise Fail(f'系统层文件表有一行看不懂：{line}')
        src, dest, mode, owner, acts = parts
        actions = acts.split(',')
        ok = (dest.startswith(DEST_PREFIXES) and os.path.normpath(dest) == dest and '..' not in dest
              and dest not in seen and owner in OWNERS and all(valid_action(a) for a in actions)
              and (src == '-' or (re.fullmatch(r'[0-7]{3,4}', mode) and '..' not in src
                                  and not src.startswith('/') and (tree / src).is_file()
                                  and not (tree / src).is_symlink())))
        if not ok:
            raise Fail(f'系统层文件表有一行不对：{line}')
        seen.add(dest)
        entries.append((src, dest, mode, owner, actions))
    if not entries:
        raise Fail('系统层文件表是空的')
    return entries, requires


def installed_files(tree, entries):
    """{dest: sha256} of what this layer installs (its own files: not the kept user configs)."""
    return {dest: file_sha(tree / src) for src, dest, _m, _o, acts in entries
            if src != '-' and 'keep' not in acts}


def tree_id(tree, entries):
    """One id for the whole file set (the manifest and build-image.sh compare it)."""
    lines = sorted(f'{dest} {mode} {owner} {file_sha(tree / src)}'
                   for src, dest, mode, owner, acts in entries if src != '-' and 'keep' not in acts)
    return hashlib.sha256('\n'.join(lines).encode()).hexdigest()


def system_record():
    try:
        return json.loads(SYS_RECORD.read_text())
    except (OSError, ValueError):
        return {}


def system_version():
    return system_record().get('version') or SYS_BASELINE


def valid_system(s):
    try:
        f = s['file']
        return bool(VERSION_RE.fullmatch(s['version']) and isinstance(s.get('notes', []), list)
                    and re.fullmatch(r'[0-9a-f]{64}', s['tree'])
                    and all(isinstance(p, str) and PKG_RE.fullmatch(p) for p in s.get('requires', []))
                    and isinstance(f['path'], str) and '..' not in f['path']
                    and not f['path'].startswith('/') and isinstance(f['size'], int) and f['size'] > 0
                    and re.fullmatch(r'[0-9a-f]{64}', f['sha256']))
    except (KeyError, TypeError):
        return False


def pkg_installed(name):
    r = subprocess.run(['dpkg-query', '-W', '-f=${Status}', name], capture_output=True, text=True)
    return r.returncode == 0 and r.stdout.endswith(' installed')


def note_system(st, m):
    sysst = st.setdefault('system', {})
    sysst['current'] = system_version()
    s = m.get('system')
    if s is not None and not valid_system(s):
        log('manifest: ignoring a malformed system entry')
        s = None
    if s and version_key(s['version']) > version_key(sysst['current']):
        sysst['available'] = {'version': s['version'], 'notes': s.get('notes', []),
                              'size': s['file']['size'],
                              'missing': [p for p in s.get('requires', []) if not pkg_installed(p)]}
    else:
        sysst['available'] = None


def own(path, owner):
    os.chown(path, pwd.getpwnam(owner).pw_uid, grp.getgrnam(owner).gr_gid)


def make_parents(path, owner):
    missing = []
    d = path.parent
    while not d.exists():
        missing.append(d)
        d = d.parent
    for d in reversed(missing):
        d.mkdir()
        os.chmod(d, 0o755)
        own(d, owner)


def put_file(data_from, path, mode, owner):
    """Write a file atomically (a power cut leaves the old or the new one)."""
    make_parents(path, owner)
    tmp = path.with_name(f'.{path.name}.tsupd')
    shutil.copyfile(data_from, tmp)
    os.chmod(tmp, mode)
    own(tmp, owner)
    os.replace(tmp, path)


def run_cmd(*cmd, timeout=120):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        log('run', cmd, e)
        return 1, ''
    if r.returncode:
        log('run', cmd, '->', r.returncode, r.stderr.strip()[-300:])
    return r.returncode, r.stdout


def as_user(*cmd, timeout=120):
    uid = pwd.getpwnam(USER).pw_uid
    return run_cmd('runuser', '-u', USER, '--', 'env', f'XDG_RUNTIME_DIR=/run/user/{uid}', *cmd,
                   timeout=timeout)


def unit_of(dest):
    """('system'|'user', unit name) for a unit file the table installs, else None."""
    name = dest.rsplit('/', 1)[-1]
    if not UNIT_RE.fullmatch(name):
        return None
    if dest.startswith('/etc/systemd/system/'):
        return 'system', name
    if dest.startswith('/home/ubuntu/.config/systemd/user/'):
        return 'user', name
    return None


def make_backup(dests):
    """Copy every destination as it is now into SYS_BACKUP (absent ones recorded as such)."""
    new = SYSTEM / 'backup.new'
    shutil.rmtree(new, ignore_errors=True)
    (new / 'files').mkdir(parents=True)
    index = []
    for i, dest in enumerate(sorted(dests)):
        path = target(dest)
        item = {'dest': dest, 'present': path.is_file() and not path.is_symlink()}
        if item['present']:
            stt = path.stat()
            item.update(mode=stt.st_mode & 0o7777, uid=stt.st_uid, gid=stt.st_gid, sha256=file_sha(path))
            shutil.copyfile(path, new / 'files' / str(i))
        index.append(item)
    (new / 'index.json').write_text(json.dumps(index, indent=1))
    os.sync()       # the copies on disk before they replace the previous backup
    shutil.rmtree(SYS_BACKUP, ignore_errors=True)
    os.replace(new, SYS_BACKUP)
    os.sync()
    return {item['dest']: item for item in index}


def apply_files(tree, entries, old_record, backup):
    """Install the table's files; returns the actions of the files that changed (sorted), and the
    destinations the old version had and this one dropped (removed)."""
    actions = set()
    for src, dest, mode, owner, acts in entries:
        path = target(dest)
        if src == '-':
            continue
        if 'keep' in acts and path.exists():
            continue
        if file_sha(path) == file_sha(tree / src):
            continue
        put_file(tree / src, path, int(mode, 8), owner)
        actions.update(a for a in acts if a != 'keep')
        if unit_of(dest):
            actions.add('reload')
    dropped = set(old_record.get('files', {})) - {e[1] for e in entries}
    for dest in dropped:
        path = target(dest)
        if path.is_file():
            unit = unit_of(dest)
            if unit:
                disable_unit(*unit)
                actions.add('reload')
            path.unlink()
    if (tree / POST).is_file():
        rc, _ = run_cmd('sh', str(tree / POST), str(tree), timeout=300)
        if rc:
            raise Fail('系统层收尾脚本出错')
    for src, dest, _m, _o, acts in entries:
        if src == '-' and file_sha(target(dest)) != (backup.get(dest) or {}).get('sha256'):
            actions.update(a for a in acts if a != 'keep')
    actions.discard('none')
    return sorted(actions)


def disable_unit(kind, unit):
    if kind == 'system':
        run_cmd('systemctl', 'disable', '--now', unit)
    else:
        as_user('systemctl', '--user', 'disable', '--now', unit)


def wp_volume():
    rc, out = as_user('wpctl', 'get-volume', '@DEFAULT_AUDIO_SINK@', timeout=10)
    m = re.search(r'Volume: ([0-9.]+)', out) if rc == 0 else None
    return m.group(1) if m else None


def take_effect(actions):
    """Make the changed files count: restart what reads them. Order: unit files, audio, services,
    the screen last (it reloads the page the user is looking at)."""
    if 'reload' in actions:
        run_cmd('systemctl', 'daemon-reload')
        as_user('systemctl', '--user', 'daemon-reload')
    audio = 'pipewire' in actions or 'wireplumber' in actions
    if audio:
        # README 3.4: with thinksmart-mic holding the capture PCM, WirePlumber finds no sound card
        vol = wp_volume()
        as_user('systemctl', '--user', 'stop', 'thinksmart-mic.service')
        if 'pipewire' in actions:
            as_user('systemctl', '--user', 'restart', 'pipewire.service', 'pipewire-pulse.service',
                    'wireplumber.service')
        else:
            as_user('systemctl', '--user', 'restart', 'wireplumber.service')
        time.sleep(5)
        as_user('systemctl', '--user', 'start', 'thinksmart-mic.service')
        if vol:     # WirePlumber puts back the volume it saved, not the one the user set
            for _ in range(10):
                if as_user('wpctl', 'set-volume', '@DEFAULT_AUDIO_SINK@', vol, timeout=10)[0] == 0:
                    break
                time.sleep(1)
    elif 'mic' in actions:
        as_user('systemctl', '--user', 'restart', 'thinksmart-mic.service')
    if audio or 'mic' in actions:
        run_cmd('systemctl', 'restart', UNIT)    # rather than waiting for it to notice
    for a in actions:
        kind, _, unit = a.partition(':')
        if kind == 'system':
            run_cmd('systemctl', 'restart', unit)
        elif kind == 'user':
            as_user('systemctl', '--user', 'restart', unit)
    if 'bluetooth' in actions:
        run_cmd('systemctl', 'restart', 'bluetooth.service')
    if 'kiosk' in actions:
        run_cmd('systemctl', 'restart', 'thinksmart-kiosk.service')


def unit_state(kind, unit):
    """(active?, restart count) of a unit."""
    show = ('systemctl', 'show', '-p', 'ActiveState', '-p', 'NRestarts', unit)
    rc, out = run_cmd(*show) if kind == 'system' else as_user(show[0], '--user', *show[1:])
    vals = dict(line.split('=', 1) for line in out.splitlines() if '=' in line)
    return vals.get('ActiveState') == 'active', vals.get('NRestarts')


def kiosk_pid():
    """The kiosk browser (thinksmart-kiosk-app runs it again 2 s after it exits). Anchored on the
    whole command: a shell or editor whose command line merely mentions the path must not count."""
    rc, out = run_cmd('pgrep', '-f', '-o', r'^/usr/bin/python3 /usr/local/bin/thinksmart-kiosk\.py$')
    return out.strip() or None


def system_checks(actions, need_hub, need_audio=True):
    """{check name: value or None}; None = not passing. Equal values twice, 10 s apart = stable."""
    out = {}
    for a in actions:
        kind, _, unit = a.partition(':')
        if kind in ('system', 'user'):
            active, n = unit_state(kind, unit)
            out[a] = n if active else None
    if 'bluetooth' in actions:
        active, n = unit_state('system', 'bluetooth.service')
        out['bluetooth'] = n if active else None
    if 'kiosk' in actions:
        active, _ = unit_state('system', 'thinksmart-kiosk.service')
        out['kiosk'] = kiosk_pid() if active else None
    # sound only counts if it worked before the update (like the hub): a client that had crashed, the
    # page on the welcome screen, would otherwise fail every update that touches audio, and with it
    # the client update that would fix it
    if need_audio and {'pipewire', 'wireplumber', 'mic'} & set(actions):
        h = health()
        out['audio'] = bool(h and h.get('audio') and (h.get('hub') or not need_hub)) or None
    if 'updater' in actions:
        rc, _ = run_cmd(str(target('/usr/local/sbin/thinksmart-update')), 'selftest', timeout=30)
        out['updater'] = (rc == 0) or None
    return out


SYS_CHECK_WHY = {'kiosk': '屏幕界面没有启动起来', 'audio': '麦克风或扬声器没有恢复',
                 'updater': '新的更新服务启动不了', 'bluetooth': '蓝牙服务没有启动起来'}


def system_self_test(actions, need_hub, seconds, need_audio=True):
    end = time.monotonic() + seconds
    first = {}
    while time.monotonic() < end:
        time.sleep(3)
        first = system_checks(actions, need_hub, need_audio)
        if all(v is not None for v in first.values()):
            time.sleep(10)      # still up, not restarted in between?
            again = system_checks(actions, need_hub, need_audio)
            if again == first:
                return True, ''
    bad = [k for k, v in first.items() if v is None] or list(first)
    k = bad[0] if bad else ''
    return False, SYS_CHECK_WHY.get(k, f'{k.partition(":")[2] or k} 没有正常运行')


def write_record(version, tree, entries):
    SYSTEM.mkdir(parents=True, exist_ok=True)
    # durable before the pending record goes: an empty record would read as the 20261101 image
    write_durable(SYS_RECORD, json.dumps({'version': version, 'tree': tree_id(tree, entries),
                                          'files': installed_files(tree, entries)}, indent=1))


def system_restore():
    """Put every backed-up file back as it was; returns the actions to re-run."""
    try:
        index = json.loads((SYS_BACKUP / 'index.json').read_text())
    except (OSError, ValueError):
        log('rollback: no backup')
        return []
    actions = {'reload'}
    for i, item in enumerate(index):
        path = target(item['dest'])
        if item['present']:
            if file_sha(path) != item['sha256']:
                saved = SYS_BACKUP / 'files' / str(i)
                if file_sha(saved) != item['sha256']:
                    # a damaged copy would replace the file with garbage or nothing: leave it be
                    log('rollback: backup of', item['dest'], 'is damaged, not restored')
                    continue
                make_parents(path, 'root')
                tmp = path.with_name(f'.{path.name}.tsupd')
                shutil.copyfile(saved, tmp)
                os.chmod(tmp, item['mode'])
                os.chown(tmp, item['uid'], item['gid'])
                os.replace(tmp, path)
        elif path.is_file():
            unit = unit_of(item['dest'])
            if unit:
                disable_unit(*unit)
            path.unlink()
    os.sync()       # restored files on disk before the pending record is dropped
    return sorted(actions)


def system_rollback(st, pending, why, seconds):
    version, old = pending['to'], pending['from']
    set_job(st, 'rolling_back', version, why + f'，正在退回 {old}', component='system')
    system_restore()
    actions = sorted(set(pending.get('actions') or []) | {'reload'})
    take_effect(actions)
    SYS_PENDING.unlink(missing_ok=True)
    sysst = st.setdefault('system', {})
    sysst['current'] = system_version()
    sysst['failed'] = version
    ok, _ = system_self_test([a for a in actions if a != 'updater'], False, seconds,
                             pending.get('need_audio', True))
    shutil.rmtree(SYSTEM / 'new', ignore_errors=True)
    shutil.rmtree(DOWNLOAD, ignore_errors=True)
    msg = f'系统层 {version} {why}，已退回 {old}'
    if not ok:
        msg += '，但退回后还有服务没正常启动，请重启设备'
    set_job(st, 'rolled_back', version, msg, component='system')
    return 1


def install_system(conf, version):
    st = load_status()
    cur = system_version()
    tree = SYSTEM / 'new'
    try:
        set_job(st, 'preparing', version, '正在准备', component='system')
        m = fetch_manifest(conf, st)
        note_system(st, m)
        s = m.get('system')
        if not s or not valid_system(s) or s['version'] != version:
            raise Fail('更新服务器上的系统层版本变了，请重新点更新')
        if version_key(version) <= version_key(cur):
            raise Fail(f'系统层 {version} 不比现在的 {cur} 新')
        missing = [p for p in s.get('requires', []) if not pkg_installed(p)]
        if missing:
            raise Fail(f'系统层 {version} 需要的软件包没装（{" ".join(missing)}），要重刷镜像才能用')
        if shutil.disk_usage(OPT if OPT.exists() else STATE).free < s['file']['size'] * 4 + SPARE:
            raise Fail('存储空间不够，没有安装')
        before = health()
        need_hub = bool(before and before.get('hub'))
        need_audio = bool(before and before.get('audio'))
        set_job(st, 'downloading', version, '正在下载', 0, component='system')
        pkg = download(conf, m, s['file'], st, version, 0, s['file']['size'])
        set_job(st, 'installing', version, '正在安装', component='system')
        extract(pkg, tree, True)
        entries, _ = read_table(tree)
        if tree_id(tree, entries) != s['tree']:
            raise Fail('系统层更新包和清单对不上，没有安装')
        old = system_record()
        dests = {e[1] for e in entries} | set(old.get('files', {}))
        backup = make_backup(dests)
    except Fail as e:
        shutil.rmtree(tree, ignore_errors=True)
        set_job(st, 'failed', version, str(e), component='system')
        return 1
    except Exception as e:  # noqa: BLE001 - anything else still has to reach the page
        log('system install failed:', repr(e))
        shutil.rmtree(tree, ignore_errors=True)
        set_job(st, 'failed', version, f'安装出错：{e}', component='system')
        return 1

    # from here on files change: a power cut or an error puts the backup back
    pending = {'from': cur, 'to': version, 'need_hub': need_hub, 'need_audio': need_audio, 'actions': sorted(
        {a for e in entries for a in e[4] if a not in ('keep', 'none')} | {'reload'})}
    write_durable(SYS_PENDING, json.dumps(pending))
    try:
        actions = apply_files(tree, entries, old, backup)
        log('system: changed, restarting:', ' '.join(actions) or 'nothing')
        pending['actions'] = actions
        write_durable(SYS_PENDING, json.dumps(pending))
        set_job(st, 'testing', version, '正在重启相关服务并自检', component='system')
        take_effect(actions)
        ok, why = system_self_test(actions, need_hub, TEST_SECONDS, need_audio)
    except Fail as e:
        ok, why = False, str(e)
    except Exception as e:  # noqa: BLE001
        log('system apply failed:', repr(e))
        ok, why = False, f'安装出错：{e}'
    if not ok:
        log('system self-test failed:', why)
        return system_rollback(st, pending, f'没装成功（{why}）', TEST_SECONDS)
    write_record(version, tree, entries)
    SYS_PENDING.unlink(missing_ok=True)
    os.sync()
    shutil.rmtree(tree, ignore_errors=True)
    shutil.rmtree(DOWNLOAD, ignore_errors=True)
    sysst = st.setdefault('system', {})
    sysst.update(current=version, available=None, reboot='boot' in actions)
    sysst.pop('failed', None)
    msg = f'系统层已更新到 {version}'
    if 'boot' in actions:
        msg += '，部分改动重启设备后生效'
    set_job(st, 'done', version, msg, component='system')
    return 0


def system_apply_checkout(tree):
    """image/device-setup.sh files: install from a checkout, record its version; restarts are the
    caller's (or a reboot)."""
    tree = tree.resolve()
    version = (tree / 'VERSION').read_text().strip()
    if not VERSION_RE.fullmatch(version):
        sys.exit(f'bad VERSION: {version!r}')
    try:
        entries, requires = read_table(tree)
    except Fail as e:
        sys.exit(str(e))
    missing = [p for p in requires if not pkg_installed(p)]
    if missing:
        log('warning: packages the system layer needs are not installed:', ' '.join(missing))
    backup = {e[1]: {'sha256': file_sha(target(e[1]))} for e in entries if e[0] == '-'}
    try:
        actions = apply_files(tree, entries, system_record(), backup)
    except Fail as e:
        sys.exit(str(e))
    write_record(version, tree, entries)
    st = load_status()
    st.setdefault('system', {}).update(current=version, available=None)
    save_status(st)
    log(f'system layer {version} installed; changed: {" ".join(actions) or "nothing"}')
    return 0


def system_verify():
    """For build-image.sh: the installed version and file-set id, and every recorded file intact."""
    rec = system_record()
    if not rec:
        print(SYS_BASELINE, '-')
        return 0
    bad = [d for d, sha in rec.get('files', {}).items() if file_sha(target(d)) != sha]
    print(rec['version'], rec.get('tree', '-'))
    for d in bad:
        print('changed since installed:', d, file=sys.stderr)
    return 1 if bad else 0


# ---- check, requests, boot ----

def note_available(st, m, cur):
    if cur is None or version_key(m['version']) > version_key(cur):
        st['available'] = {'version': m['version'], 'notes': m.get('notes', []),
                           'published': m.get('published'), 'size': download_size(m)}
    else:
        st['available'] = None


def check(conf):
    st = load_status()
    st['current'] = current_version()
    st['checked'] = int(time.time())
    try:
        m = fetch_manifest(conf, st)
        note_available(st, m, st['current'])
        note_system(st, m)
        st['check_error'] = None
    except Fail as e:
        st['check_error'] = str(e)
    except Exception as e:  # noqa: BLE001
        log('check failed:', repr(e))
        st['check_error'] = '检查更新出错'
    save_status(st)
    log('check:', st.get('available'), (st.get('system') or {}).get('available'), st.get('check_error'))
    return 0


def run(conf):
    """Requests from the page: files in requests/, each {"action": "check"|"install", "version": ...}."""
    actions = {}
    for f in sorted(REQUESTS.glob('*')):
        if f.name.startswith('.'):        # .install.tmp: still being written
            continue
        try:
            if f.stat().st_size < 1024:
                body = json.loads(f.read_text())
                actions[body.get('action')] = body
        except (OSError, ValueError, AttributeError):
            pass
        f.unlink(missing_ok=True)
    if 'install' in actions:
        body = actions['install']
        st = load_status()
        avail = st.get('available') or {}
        savail = (st.get('system') or {}).get('available') or {}
        # only what we checked ourselves; the request can't name an arbitrary version
        client_v = avail.get('version') if avail.get('version') == str(body.get('version', '')) else None
        system_v = (savail.get('version') if savail.get('version') == str(body.get('system', ''))
                    and not savail.get('missing') else None)
        if client_v or system_v:
            if system_v:
                rc = install_system(conf, system_v)
                if rc or not client_v:
                    return rc          # a failed system layer stops here: the client waits
            rc = install(conf, client_v)
            if rc == 0 and system_v:
                # both went in with one tap: say so in the one result the pages show (the client's
                # own 已更新到 would hide the system layer's)
                st = load_status()
                msg = f'已更新到 系统层 {system_v} · 客户端 {client_v}'
                if (st.get('system') or {}).get('reboot'):
                    msg += '，部分改动重启设备后生效'
                set_job(st, 'done', client_v, msg)
            return rc
        log('install request ignored:', body, avail, savail)
        return check(conf)
    if 'check' in actions:
        return check(conf)
    return 0


def recover(conf, seconds, why):
    """Finish or undo an update whose process is gone. Runs holding the lock, so no update is
    running: a job still in an active state was cut off (power cut, reboot, systemd's timeout, a
    crash) and the page would show it as running, update button hidden, until this clears it."""
    for d in list(CLIENT.glob('*.new')) + list(ENVS.glob('*.new')):
        shutil.rmtree(d, ignore_errors=True)
    st = load_status()
    try:
        spending = json.loads(SYS_PENDING.read_text())
    except (OSError, ValueError):
        spending = None
    shutil.rmtree(SYSTEM / 'new', ignore_errors=True)
    if spending and system_record().get('version') == spending['to']:
        # it passed its self-test and was recorded; only dropping the pending record didn't reach
        # the disk. Rolling back now would run the old files under the new version's record.
        log('recover: system layer', spending['to'], 'was already installed, keeping it')
        SYS_PENDING.unlink(missing_ok=True)
        os.sync()
        sysst = st.setdefault('system', {})
        sysst.update(current=spending['to'], available=None)
        sysst.pop('failed', None)
        if (st.get('job') or {}).get('state') in ACTIVE_JOBS:
            set_job(st, 'done', spending['to'], f'系统层已更新到 {spending["to"]}', component='system')
        else:
            save_status(st)
        spending = None
    if spending:
        # half-applied files or an untested switch: the backup is what last worked
        log('recover: a system layer install was interrupted, putting the backup back')
        system_rollback(st, spending, f'上次系统层更新被中断（{why}）', seconds)
        return 0
    try:
        pending = json.loads(PENDING.read_text())
    except (OSError, ValueError):
        pending = None
    if pending:
        if current_version() == pending['to']:
            log('recover: an update was interrupted during its self-test, testing again')
            set_job(st, 'testing', pending['to'], '上次更新被中断，正在重新自检')
            return finish(conf, st, pending, seconds)
        PENDING.unlink(missing_ok=True)
    job = st.get('job') or {}
    if job.get('state') in ACTIVE_JOBS:
        set_job(st, 'failed', job.get('version'), f'上次更新被中断（{why}），没有改动',
                component=job.get('component', 'client'))
    return 0


def boot(conf):
    return recover(conf, BOOT_TEST_SECONDS, '断电或重启')


def adopt(src, version=None):
    """Install a client checkout (with its .venv) as a version, e.g. the one the image ships."""
    src = Path(src).resolve()
    if version is None:
        for line in (src / 'thinksmart_client' / '__init__.py').read_text().splitlines():
            if line.startswith('__version__'):
                version = line.split('=', 1)[1].strip().strip('\'"')
    if not version:
        sys.exit('no version given and none in thinksmart_client/__init__.py')
    lock = src / 'requirements.lock'
    env_id = hashlib.sha256(lock.read_bytes()).hexdigest()[:16] if lock.exists() else 'adopted'
    CLIENT.mkdir(parents=True, exist_ok=True)
    ENVS.mkdir(parents=True, exist_ok=True)
    if not env_present(env_id):
        venv = (src / '.venv').resolve()
        subprocess.run(['cp', '-a', str(venv), str(ENVS / f'{env_id}.new')], check=True)
        subprocess.run(['chown', '-R', 'root:root', str(ENVS / f'{env_id}.new')], check=True)
        os.replace(ENVS / f'{env_id}.new', ENVS / env_id)
    dest = CLIENT / version
    if dest.exists():
        shutil.rmtree(dest)
    shutil.copytree(src, dest, symlinks=True,
                    ignore=shutil.ignore_patterns('.venv', '__pycache__', '.git'))
    subprocess.run(['chown', '-R', 'root:root', str(dest)], check=True)
    subprocess.run(['chmod', '-R', 'go-w', str(dest)], check=True)
    link_env(dest, env_id)
    set_link('current', version)
    st = load_status()
    st['current'] = version
    save_status(st)
    sync_unit(version)
    log(f'adopted {src} as {version} (env {env_id})')
    return 0


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    conf = read_conf()
    cmd = sys.argv[1]
    if cmd == 'selftest':       # run by an install of a new updater while the old one holds the lock
        print(f'thinksmart-update {UPDATER_VERSION}', 'sources:', conf['SOURCES'] or '-')
        return 0
    if cmd == 'system-verify':
        return system_verify()
    STATE.mkdir(parents=True, exist_ok=True)
    REQUESTS.mkdir(exist_ok=True)
    shutil.chown(REQUESTS, 'root', conf['REQUEST_GROUP'])
    REQUESTS.chmod(0o770)
    # one at a time: the daily check waits while an install runs
    with open(LOCK, 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if cmd in ('check', 'run', 'install'):
            recover(conf, TEST_SECONDS, '下载太慢超时或出错')
        if cmd == 'check':
            return check(conf)
        if cmd == 'run':
            return run(conf)
        if cmd == 'install' and len(sys.argv) == 3:
            return install(conf, sys.argv[2])
        if cmd == 'boot':
            return boot(conf)
        if cmd == 'adopt' and len(sys.argv) in (3, 4):
            return adopt(sys.argv[2], sys.argv[3] if len(sys.argv) == 4 else None)
        if cmd == 'system-apply' and len(sys.argv) == 3:
            return system_apply_checkout(Path(sys.argv[2]))

    sys.exit(__doc__)


if __name__ == '__main__':
    sys.exit(main())
